{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gcl/critic_output.schema.json",
  "title": "GCL CriticOutput",
  "type": "object",
  "required": ["scores"],
  "properties": {
    "scores": {
      "type": "object",
      "required": [
        "correctness",
        "safety",
        "idempotency",
        "traceability",
        "spec_compliance"
      ],
      "properties": {
        "correctness":     { "type": "number", "minimum": 0, "maximum": 1 },
        "safety":          { "type": "number", "minimum": 0, "maximum": 1 },
        "idempotency":     { "type": "number", "minimum": 0, "maximum": 1 },
        "traceability":    { "type": "number", "minimum": 0, "maximum": 1 },
        "spec_compliance": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "suggestions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "blocking": { "type": "boolean" },
    "mode": { "type": "string" }
  },
  "additionalProperties": false
}
