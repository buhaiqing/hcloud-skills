{
  "$schema": "remediation-playbooks/v1",
  "skill_id": "huaweicloud-vpc-ops",
  "playbooks": [
    {
      "id": "VPC-R001",
      "name": "Security Group Rule Stale Cleanup",
      "trigger": {
        "condition": "\u003e 5 rules unused for 30d",
        "metric": "sg_unused_rules",
        "namespace": "SYS.VPC"
      },
      "diagnosis": {
        "confidence_factors": [
          "rules_unused",
          "no_recent_match",
          "no_compliance_lock"
        ],
        "steps": [
          "hcloud VPC showSecurityGroup --id {{output.sg_id}}",
          "hcloud CTS listTraces --resource_type security_group --limit 100"
        ]
      },
      "remediation": {
        "auto_execute_threshold": 0.85,
        "dry_run": "hcloud VPC deleteSecurityGroupRule --sg_id {{output.sg_id}} --rule_id {{output.rule_id}} --dry-run",
        "execute": "hcloud VPC deleteSecurityGroupRule --sg_id {{output.sg_id}} --rule_id {{output.rule_id}}",
        "preconditions": [
          "hcloud VPC showSecurityGroup --id {{output.sg_id}} | grep -q active"
        ],
        "risk_level": "low",
        "verification": "hcloud VPC showSecurityGroup --id {{output.sg_id}}"
      }
    },
    {
      "id": "VPC-R002",
      "name": "Subnet CIDR Auto-Allocate",
      "trigger": {
        "condition": "\u003c 10 remaining",
        "metric": "subnet_available_ips",
        "namespace": "SYS.VPC"
      },
      "diagnosis": {
        "confidence_factors": [
          "cidr_exhausted",
          "vpc_cidr_room_available",
          "no_overlap"
        ],
        "steps": [
          "hcloud VPC showSubnet --subnet_id {{output.subnet_id}}",
          "hcloud VPC listSubnets --vpc_id {{output.vpc_id}}"
        ]
      },
      "remediation": {
        "auto_execute_threshold": 0.9,
        "dry_run": "hcloud VPC createSubnet --vpc_id {{output.vpc_id}} --cidr {{output.next_cidr}} --dry-run",
        "execute": "hcloud VPC createSubnet --vpc_id {{output.vpc_id}} --cidr {{output.next_cidr}}",
        "preconditions": [
          "hcloud VPC listVpcs --vpc_id {{output.vpc_id}} | grep -q ACTIVE"
        ],
        "risk_level": "medium",
        "verification": "hcloud VPC showSubnet --subnet_id {{output.new_subnet_id}}"
      }
    },
    {
      "id": "VPC-R003",
      "name": "EIP Bandwidth Upgrade",
      "trigger": {
        "condition": "\u003e 85 for 5min",
        "metric": "eip_bandwidth_util",
        "namespace": "SYS.VPC"
      },
      "diagnosis": {
        "confidence_factors": [
          "bw_sustained_high",
          "quota_available",
          "no_maintenance_window"
        ],
        "steps": [
          "hcloud CES getMetricData --namespace SYS.VPC --metric_name eip_bandwidth_util --period 60 --filter avg",
          "hcloud VPC showEip --eip_id {{output.eip_id}}"
        ]
      },
      "remediation": {
        "auto_execute_threshold": 0.9,
        "dry_run": "hcloud VPC updateEipBandwidth --eip_id {{output.eip_id}} --bandwidth {{output.bw_mbps}} --dry-run",
        "execute": "hcloud VPC updateEipBandwidth --eip_id {{output.eip_id}} --bandwidth {{output.bw_mbps}}",
        "preconditions": [
          "hcloud VPC showEip --eip_id {{output.eip_id}} | grep -q ACTIVE"
        ],
        "risk_level": "low",
        "verification": "hcloud VPC showEip --eip_id {{output.eip_id}}"
      }
    },
    {
      "id": "VPC-R004",
      "name": "ACL Route Drift Repair",
      "trigger": {
        "condition": "\u003e 0 missing routes for 5min",
        "metric": "route_drift_count",
        "namespace": "SYS.VPC"
      },
      "diagnosis": {
        "confidence_factors": [
          "routes_missing",
          "peering_active",
          "config_known"
        ],
        "steps": [
          "hcloud VPC showRouteTable --route_table_id {{output.rt_id}}",
          "hcloud VPC listVpcPeerings --status ACTIVE"
        ]
      },
      "remediation": {
        "auto_execute_threshold": 0.9,
        "dry_run": "hcloud VPC createRoutes --route_table_id {{output.rt_id}} --routes {{output.routes_json}} --dry-run",
        "execute": "hcloud VPC createRoutes --route_table_id {{output.rt_id}} --routes {{output.routes_json}}",
        "preconditions": [
          "hcloud VPC showRouteTable --route_table_id {{output.rt_id}} | grep -q ACTIVE"
        ],
        "risk_level": "medium",
        "verification": "hcloud VPC showRouteTable --route_table_id {{output.rt_id}}"
      }
    }
  ]
}